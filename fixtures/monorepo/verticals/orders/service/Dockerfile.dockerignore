# Allow list for this image, built from the repository root: the shared build, the libraries, every contract and
# this vertical, so a change inside another vertical never reaches its context (container image guide, step 5;
# monorepo guide, step 10).
*
!gradlew
!settings.gradle.kts
!gradle.properties
!gradle/
!build-logic/
!config/
!.github/scripts/gradle-ci.sh
!libs/
!verticals/*/api/
!verticals/orders/service/build.gradle.kts
!verticals/orders/service/src/
**/build
**/.gradle
**/.kotlin
