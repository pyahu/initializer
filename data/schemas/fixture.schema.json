{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initializer.pyahu.io/schemas/fixture.schema.json",
  "title": "Fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "baseline", "stage", "options", "exercises", "requiredTests"],
  "properties": {
    "schema": {"const": "initializer.pyahu.io/fixture/v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "baseline": {"$ref": "common.schema.json#/$defs/revisionId"},
    "stage": {"type": "integer", "minimum": 1},
    "options": {"$ref": "options.schema.json"},
    "exercises": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/componentKey"}, "uniqueItems": true},
    "requiredTests": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/testRef"}, "uniqueItems": true}
  }
}
