{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initializer.pyahu.io/schemas/versions.schema.json",
  "title": "Baseline revisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "active",
    "revisions"
  ],
  "properties": {
    "schema": {
      "const": "initializer.pyahu.io/versions/v1"
    },
    "active": {
      "$ref": "common.schema.json#/$defs/revisionId"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/revision"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "created",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/revisionId"
        },
        "release": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/componentKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "managedBy",
        "verifiedAt",
        "guides",
        "claims",
        "qualification"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "maven",
            "maven-bom",
            "gradle-plugin",
            "jdk",
            "image",
            "tool",
            "platform",
            "spec"
          ]
        },
        "coordinates": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9./_-]+:[A-Za-z0-9._-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "distributionSha256Sum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "managedBy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/componentKey"
            }
          ]
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 1
        },
        "guides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "uniqueItems": true
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "capabilities"
          ],
          "properties": {
            "state": {
              "enum": [
                "provisional",
                "partial",
                "qualified"
              ]
            },
            "capabilities": {
              "type": "object",
              "propertyNames": {
                "$ref": "common.schema.json#/$defs/capability"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "maven",
                  "maven-bom"
                ]
              }
            }
          },
          "then": {
            "required": [
              "coordinates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gradle-plugin"
              }
            }
          },
          "then": {
            "required": [
              "pluginId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "jdk"
              }
            }
          },
          "then": {
            "required": [
              "vendor",
              "feature",
              "build"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "image",
              "digest"
            ]
          }
        }
      ]
    }
  }
}
