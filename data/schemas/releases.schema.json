{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initializer.pyahu.io/schemas/releases.schema.json",
  "title": "Release notes, one entry per baseline revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releases"],
  "properties": {
    "schema": {"const": "initializer.pyahu.io/releases/v1"},
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "previous", "summary"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/revisionId"},
        "status": {"enum": ["released", "unreleased", "initial"]},
        "date": {"$ref": "common.schema.json#/$defs/date"},
        "previous": {"oneOf": [{"$ref": "common.schema.json#/$defs/revisionId"}, {"type": "null"}]},
        "summary": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "guides": {"type": "array", "items": {"$ref": "#/$defs/guideChange"}},
        "changes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "appliesWhen", "files", "detect", "steps", "verify"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "kind": {"enum": ["required", "recommended", "optional"]},
        "title": {"type": "string", "minLength": 1},
        "appliesWhen": {"$ref": "common.schema.json#/$defs/filter"},
        "when": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "detect": {"type": "string", "minLength": 1},
        "steps": {"type": "string", "minLength": 1},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/componentKey"}},
        "verify": {"type": "string", "minLength": 1},
        "guide": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(#[a-z]{2,5}-[a-z0-9]+(-[a-z0-9]+)*)?$"}
      }
    },
    "guideChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "text"],
      "properties": {
        "step": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[a-z]{2,5}-[a-z0-9]+(-[a-z0-9]+)*$"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
