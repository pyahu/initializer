{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initializer.pyahu.io/schemas/evidence.schema.json",
  "title": "Evidence records of one guide",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "card", "claim", "badge", "baseline", "limitations"],
    "properties": {
      "id": {"$ref": "common.schema.json#/$defs/evidenceId"},
      "card": {"$ref": "common.schema.json#/$defs/cardId"},
      "claim": {"type": "string", "minLength": 1},
      "badge": {"enum": ["compiled", "reproduced", "measured", "cluster-run", "not-exercised"]},
      "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/capability"}, "uniqueItems": true},
      "components": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/componentKey"}, "uniqueItems": true},
      "baseline": {"$ref": "common.schema.json#/$defs/revisionId"},
      "fixture": {"type": "string", "minLength": 1},
      "test": {"$ref": "common.schema.json#/$defs/testRef"},
      "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "environment": {"type": "string", "minLength": 1},
      "run": {"type": "string", "pattern": "^https://github\\.com/pyahu/initializer/actions/runs/[0-9]+/attempts/[0-9]+$"},
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "date": {"$ref": "common.schema.json#/$defs/date"},
      "result": {"type": "string", "minLength": 1},
      "limitations": {"type": "string", "minLength": 1},
      "cluster": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "kubernetesVersion", "cni"],
        "properties": {"kind": {"type": "string"}, "kubernetesVersion": {"type": "string"}, "cni": {"type": "string"}}
      },
      "measurement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["samples", "statistic", "unit", "protocol"],
        "properties": {
          "samples": {"type": "integer", "minimum": 1},
          "statistic": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1}
        }
      },
      "reason": {"type": "string", "minLength": 1}
    },
    "if": {"properties": {"badge": {"const": "not-exercised"}}},
    "then": {
      "required": ["reason"],
      "not": {"anyOf": [
        {"required": ["capabilities"]}, {"required": ["run"]}, {"required": ["commit"]}, {"required": ["result"]}, {"required": ["test"]}
      ]}
    },
    "else": {
      "required": ["capabilities", "components", "fixture", "test", "commands", "environment", "run", "commit", "date", "result"],
      "allOf": [
        {"if": {"properties": {"badge": {"const": "cluster-run"}}}, "then": {"required": ["cluster"]}},
        {"if": {"properties": {"badge": {"const": "measured"}}}, "then": {"required": ["measurement"]}}
      ]
    }
  }
}
