{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initializer.pyahu.io/schemas/evidence.schema.json",
  "title": "Tested claims of one guide",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "card", "claim", "badge", "test", "limitations"],
    "properties": {
      "id": {"$ref": "common.schema.json#/$defs/evidenceId"},
      "card": {"$ref": "common.schema.json#/$defs/cardId"},
      "claim": {"type": "string", "minLength": 1},
      "badge": {"enum": ["compiled", "reproduced", "measured"]},
      "test": {"$ref": "common.schema.json#/$defs/testRef"},
      "result": {"type": "string", "minLength": 1},
      "limitations": {"type": "string", "minLength": 1},
      "run": {"type": "string", "pattern": "^https://github\\.com/pyahu/initializer/actions/runs/[0-9]+/attempts/[0-9]+$"},
      "date": {"$ref": "common.schema.json#/$defs/date"},
      "measurement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["samples", "statistic", "unit", "protocol"],
        "properties": {
          "samples": {"type": "integer", "minimum": 1},
          "statistic": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1}
        }
      }
    },
    "if": {"properties": {"badge": {"const": "measured"}}},
    "then": {"required": ["measurement", "result", "run", "date"]},
    "else": {"not": {"anyOf": [{"required": ["measurement"]}, {"required": ["run"]}, {"required": ["date"]}]}}
  }
}
