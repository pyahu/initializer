---
// The guide's map: the questions it answers in order and one line on how it is proven.
import { Aside } from "@astrojs/starlight/components";
import data from "../generated/guides.json";
interface Props {
  guide: string;
}
const { guide } = Astro.props;
const g = (data.guides as any)[guide];
if (!g) throw new Error(`GuideStatus: unknown guide ${guide}`);
---
<div class="guide-map not-content">
  {g.status.reverify && (
    <Aside type="caution" title="Re-verify">
      <ul>{g.status.reverifyReasons.map((r: string) => <li>{r}</li>)}</ul>
    </Aside>
  )}
  {g.status.stale && <Aside type="caution" title="Stale">This guide was last verified more than two baseline revisions ago.</Aside>}
  <nav class="guide-map-block" aria-labelledby={`${guide}-learn`}>
    <h2 class="guide-map-title" id={`${guide}-learn`}>What you'll learn</h2>
    <ul class="guide-contents">
      {g.contents.map((c: any) => <li><a href={`#${c.id}`}>{c.title}</a></li>)}
    </ul>
    <p class="guide-more">
      Then <a href="#put-it-all-together">put it all together</a> with tested files and review a service with the <a href="#checklist">checklist</a>.
    </p>
  </nav>
  <p class="guide-proof">Every step ends with <em>How we checked this</em>: the test behind each claim or why there is none yet. {g.verification && <>Last full check: {g.verification}. </>}Versions: baseline <a href="/reference/docs/">{g.baseline}</a>. <a href="/#proof">How the guides are proven</a>.</p>
  {g.sources.length > 0 && (
    <p class="guide-sources">
      {g.sources.map((s: any) => <>Adapted from “{s.title}” by {s.author} ({s.date}), {s.license}. </>)}
    </p>
  )}
</div>
