---
// The official documents a guide relies on.
import data from "../generated/guides.json";
interface Props {
  guide: string;
}
const { guide } = Astro.props;
const g = (data.guides as any)[guide];
if (!g) throw new Error(`GuideReferences: unknown guide ${guide}`);
---
<details class="not-content guide-references">
  <summary>Official documentation</summary>
  <p>The full list is on <a href="/reference/docs/">Reference docs</a>.</p>
  <ul>
    {g.references.map((r: any) => (
      <li><a href={r.url}>{r.title}</a> ({r.version}{r.pinned ? "" : ", not version-pinned"}). {r.purpose}</li>
    ))}
  </ul>
</details>
