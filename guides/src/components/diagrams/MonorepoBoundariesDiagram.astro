---
// Dependency graph: what the services in one repository may depend on and the one edge that is forbidden.
import Diagram from "../Diagram.astro";
---
<Diagram id="mono-boundaries"
  caption="One repository, separate services: they share build rules and contracts, never each other's code."
  description="A frame labelled one repository holds six boxes in two rows. Top row, all recommended: build-logic, an included build with convention plugins only; the version catalog in gradle/libs.versions.toml; and contracts/orders, the API contract owned by the orders service and checked in CI. Bottom row: services/orders, with its own architecture style, image and deploy folder; orders-client, recommended, a project generated from the orders contract; and services/billing, which uses orders-client only. Arrows point from the dependent to its dependency: both services apply the convention plugins from build-logic, build-logic reads the version catalog, orders-client is generated from contracts/orders and billing uses orders-client. A dotted failure arrow from billing to orders, marked with a cross, shows the forbidden edge: a service never depends on another service's project.">
  <svg viewBox="0 0 1000 440">
    <defs>
      <marker id="mono-boundaries-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-accent" /></marker>
      <marker id="mono-boundaries-fail" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-fail" /></marker>
    </defs>
    <rect x="20" y="20" width="960" height="404" rx="8" class="dg-frame" />
    <text x="36" y="44" class="dg-group">ONE REPOSITORY</text>

    <rect x="40" y="64" width="260" height="70" rx="6" class="dg-box dg-emphasis" />
    <text x="56" y="92" class="dg-title">build-logic</text>
    <text x="56" y="116" class="dg-detail">convention plugins only</text>

    <rect x="370" y="64" width="260" height="70" rx="6" class="dg-box dg-emphasis" />
    <text x="386" y="92" class="dg-title">Version catalog</text>
    <text x="386" y="116" class="dg-detail">gradle/libs.versions.toml</text>

    <rect x="700" y="64" width="260" height="70" rx="6" class="dg-box dg-emphasis" />
    <text x="716" y="92" class="dg-title">contracts/orders</text>
    <text x="716" y="116" class="dg-detail">owned by orders, checked in CI</text>

    <rect x="40" y="232" width="260" height="84" rx="6" class="dg-box" />
    <text x="56" y="260" class="dg-title">services/orders</text>
    <text x="56" y="284" class="dg-detail">its own style, image</text>
    <text x="56" y="302" class="dg-detail">and deploy folder</text>

    <rect x="370" y="232" width="260" height="84" rx="6" class="dg-box dg-emphasis" />
    <text x="386" y="260" class="dg-title">orders-client</text>
    <text x="386" y="284" class="dg-detail">a project generated</text>
    <text x="386" y="302" class="dg-detail">from the contract</text>

    <rect x="700" y="232" width="260" height="84" rx="6" class="dg-box" />
    <text x="716" y="260" class="dg-title">services/billing</text>
    <text x="716" y="284" class="dg-detail">uses orders-client only</text>

    <path d="M150 232 V137" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="158" y="192" class="dg-note dg-accent">applies</text>
    <path d="M900 232 V184 H250 V137" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="700" y="176" class="dg-note dg-accent">applies the same conventions</text>
    <path d="M300 99 H367" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="314" y="90" class="dg-note dg-accent">reads</text>
    <path d="M500 232 V137" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="508" y="216" class="dg-note dg-accent">generated from</text>
    <path d="M700 274 H633" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="648" y="266" class="dg-note dg-accent">uses</text>

    <path d="M830 316 V372 H170 V319" class="dg-line dg-fail" marker-end="url(#mono-boundaries-fail)" />
    <text x="300" y="396" class="dg-note dg-fail">✕ never a project dependency on another service</text>
  </svg>
</Diagram>
