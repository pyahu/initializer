---
// Dependency graph: what the projects in one repository may depend on and the one edge the build forbids.
import Diagram from "../Diagram.astro";
---
<Diagram id="mono-boundaries"
  caption="One repository, separate verticals: they share build rules, versions and contracts, never each other's code."
  description="A frame labelled one repository. Top row: build-logic, recommended, with one convention plugin per kind of project; the version catalog in gradle/libs.versions.toml, recommended; and libs, for reusable code only, with none to start. Below, a frame labelled verticals/orders holds two projects: :orders in service/, with its code, database, image and deploy folder, and :orders-api in api/, recommended, the contract and the code generated from it once. A frame labelled verticals/billing holds :billing in service/, with its own style and database. Arrows point from the dependent to its dependency: :orders implements :orders-api, :billing uses :orders-api, both services apply the conventions from build-logic and build-logic reads the version catalog. A dotted failure arrow from :billing to :orders, marked with a cross, shows the edge the build rejects: a service never depends on another service's project.">
  <svg viewBox="0 0 1000 480">
    <defs>
      <marker id="mono-boundaries-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-accent" /></marker>
      <marker id="mono-boundaries-fail" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-fail" /></marker>
    </defs>
    <rect x="20" y="20" width="960" height="440" rx="8" class="dg-frame" />
    <text x="36" y="44" class="dg-group">ONE REPOSITORY</text>

    <rect x="40" y="64" width="260" height="70" rx="6" class="dg-box dg-emphasis" />
    <text x="56" y="92" class="dg-title">build-logic</text>
    <text x="56" y="116" class="dg-detail">one convention per kind of project</text>

    <rect x="370" y="64" width="260" height="70" rx="6" class="dg-box dg-emphasis" />
    <text x="386" y="92" class="dg-title">Version catalog</text>
    <text x="386" y="116" class="dg-detail">gradle/libs.versions.toml</text>

    <rect x="700" y="64" width="260" height="70" rx="6" class="dg-box" />
    <text x="716" y="92" class="dg-title">libs/</text>
    <text x="716" y="116" class="dg-detail">reusable code only, none to start</text>

    <rect x="40" y="196" width="560" height="150" rx="8" class="dg-frame" />
    <text x="56" y="218" class="dg-group">VERTICALS/ORDERS</text>

    <rect x="60" y="236" width="220" height="90" rx="6" class="dg-box" />
    <text x="76" y="264" class="dg-title">:orders</text>
    <text x="76" y="288" class="dg-detail">service/: its code,</text>
    <text x="76" y="306" class="dg-detail">database, image, deploy/</text>

    <rect x="360" y="236" width="220" height="90" rx="6" class="dg-box dg-emphasis" />
    <text x="376" y="264" class="dg-title">:orders-api</text>
    <text x="376" y="288" class="dg-detail">api/: the contract and</text>
    <text x="376" y="306" class="dg-detail">the code generated once</text>

    <rect x="660" y="196" width="300" height="150" rx="8" class="dg-frame" />
    <text x="676" y="218" class="dg-group">VERTICALS/BILLING</text>

    <rect x="690" y="236" width="240" height="90" rx="6" class="dg-box" />
    <text x="706" y="264" class="dg-title">:billing</text>
    <text x="706" y="288" class="dg-detail">service/: its own style</text>
    <text x="706" y="306" class="dg-detail">and database</text>

    <path d="M280 281 H357" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="284" y="272" class="dg-note dg-accent">implements</text>
    <path d="M690 281 H583" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="612" y="272" class="dg-note dg-accent">uses</text>

    <path d="M210 236 V137" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="218" y="172" class="dg-note dg-accent">applies</text>
    <path d="M880 236 V166 H270 V137" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="640" y="158" class="dg-note dg-accent">applies the same conventions</text>
    <path d="M300 99 H367" class="dg-line dg-accent" marker-end="url(#mono-boundaries-accent)" />
    <text x="314" y="90" class="dg-note dg-accent">reads</text>

    <path d="M810 326 V392 H170 V329" class="dg-line dg-fail" marker-end="url(#mono-boundaries-fail)" />
    <text x="250" y="420" class="dg-note dg-fail">✕ the build stops: a service never depends on another service's project</text>
  </svg>
</Diagram>
