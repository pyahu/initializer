---
// Before and after: a 1 GiB container where the heap takes too much of the limit and the fix.
// Numbers are computed from the flags, not measured: 90% of 1024 MiB is 922 MiB, 75% is 768 MiB.
import Diagram from "../Diagram.astro";
---
<Diagram id="jvm-container-memory"
  caption="Why a pod is killed while the heap graph looks fine and how the limit is split instead."
  description="Two containers with a 1 GiB memory limit, drawn as bars with the limit as a dashed line at the top. Left, the failure, marked with a cross: MaxRAMPercentage=90 lets the heap reach 922 MiB, leaving 102 MiB for everything else; metaspace, code cache, thread stacks, direct buffers, GC structures and malloc need more, so resident memory crosses the limit and the kernel kills the container with exit code 137, even though the heap graph shows 60% used. Right, the recommendation: MaxRAMPercentage=75 with InitialRAMPercentage equal to it and memory request equal to limit; the heap gets 768 MiB and 256 MiB stay for non-heap memory, which you confirm with Native Memory Tracking under load.">
  <svg viewBox="0 0 1000 430">
    <rect x="16" y="16" width="476" height="398" rx="8" class="dg-frame" />
    <text x="32" y="42" class="dg-group">✕ BEFORE · MaxRAMPercentage=90</text>
    <rect x="508" y="16" width="476" height="398" rx="8" class="dg-frame" />
    <text x="524" y="42" class="dg-group">AFTER · MaxRAMPercentage=75</text>

    <line x1="24" y1="110" x2="248" y2="110" class="dg-line dg-dash" />
    <text x="24" y="104" class="dg-note">limit 1 GiB</text>
    <rect x="110" y="62" width="120" height="76" rx="4" class="dg-box dg-fail" />
    <text x="170" y="90" text-anchor="middle" class="dg-note dg-fail">non-heap</text>
    <text x="170" y="106" text-anchor="middle" class="dg-note dg-fail">over the limit</text>
    <rect x="110" y="138" width="120" height="252" rx="4" class="dg-box" />
    <rect x="110" y="239" width="120" height="151" rx="0" class="dg-fill-context" />
    <text x="170" y="190" text-anchor="middle" class="dg-title">heap</text>
    <text x="170" y="210" text-anchor="middle" class="dg-detail">max 922 MiB</text>
    <text x="170" y="320" text-anchor="middle" class="dg-detail">60% used</text>
    <text x="262" y="128" class="dg-title">OOMKilled, exit 137</text>
    <text x="262" y="152" class="dg-detail">The heap leaves 102 MiB for</text>
    <text x="262" y="172" class="dg-detail">metaspace, code cache, threads,</text>
    <text x="262" y="192" class="dg-detail">direct buffers, GC and malloc.</text>
    <text x="262" y="222" class="dg-detail">The kernel counts every resident</text>
    <text x="262" y="242" class="dg-detail">byte, not just the heap.</text>
    <path d="M258 100 L238 100" class="dg-line dg-fail" marker-end="url(#jvm-container-memory-fail)" />

    <line x1="516" y1="110" x2="740" y2="110" class="dg-line dg-dash" />
    <text x="516" y="104" class="dg-note">limit 1 GiB</text>
    <rect x="602" y="110" width="120" height="70" rx="4" class="dg-box" />
    <text x="662" y="140" text-anchor="middle" class="dg-note">non-heap</text>
    <text x="662" y="156" text-anchor="middle" class="dg-note">256 MiB</text>
    <rect x="602" y="180" width="120" height="210" rx="4" class="dg-box dg-emphasis" />
    <text x="662" y="276" text-anchor="middle" class="dg-title">heap</text>
    <text x="662" y="296" text-anchor="middle" class="dg-detail">max 768 MiB</text>
    <text x="754" y="128" class="dg-title">Fits and you prove it</text>
    <text x="754" y="152" class="dg-detail">Heap 75% of the limit, initial</text>
    <text x="754" y="172" class="dg-detail">equal to max, request = limit.</text>
    <text x="754" y="202" class="dg-detail">Confirm the non-heap share</text>
    <text x="754" y="222" class="dg-detail">with NMT under load.</text>

    <defs>
      <marker id="jvm-container-memory-fail" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-fail" /></marker>
    </defs>
  </svg>
</Diagram>
