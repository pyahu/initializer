---
// Comparison: which way the dependency arrows point in three families of styles.
import Diagram from "../Diagram.astro";
---
<Diagram id="style-arrows"
  caption="The styles differ mostly in one thing: which way the dependency arrows point."
  description="Three panels side by side; every arrow points from code to the code it depends on. Left, classic layered, also Evans' layered architecture: Web depends on Service, Service on Repository, Repository on the database; the arrows run top to bottom, so business rules sit above persistence and depend on it. Middle, highlighted, hexagonal, Onion and Clean: a domain box in the centre; the application with its ports depends on the domain; the web adapter depends on an inbound port; the database adapter implements an outbound port, so it depends on the application too; every arrow points toward the domain and the database is outside. Right, vertical slice: three columns, place order, cancel order and list orders, each with its own handler and its own data access; arrows stay inside a slice and the slices share only a thin common base.">
  <svg viewBox="0 0 1000 420">
    <defs>
      <marker id="style-arrows-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker" /></marker>
      <marker id="style-arrows-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" class="dg-marker dg-accent" /></marker>
    </defs>

    <rect x="20" y="20" width="290" height="380" rx="8" class="dg-frame" />
    <text x="36" y="46" class="dg-group">CLASSIC LAYERED</text>
    <rect x="70" y="66" width="190" height="52" rx="6" class="dg-box" />
    <text x="86" y="98" class="dg-title">Web</text>
    <path d="M165 118 V140" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <rect x="70" y="142" width="190" height="52" rx="6" class="dg-box" />
    <text x="86" y="174" class="dg-title">Service (rules)</text>
    <path d="M165 194 V216" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <rect x="70" y="218" width="190" height="52" rx="6" class="dg-box" />
    <text x="86" y="250" class="dg-title">Repository</text>
    <path d="M165 270 V292" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <rect x="70" y="294" width="190" height="52" rx="6" class="dg-box" />
    <text x="86" y="326" class="dg-title">Database</text>
    <text x="36" y="372" class="dg-note">arrows run downward:</text>
    <text x="36" y="388" class="dg-note">rules depend on persistence</text>

    <rect x="330" y="20" width="340" height="380" rx="8" class="dg-frame" />
    <text x="346" y="46" class="dg-group">HEXAGONAL · ONION · CLEAN</text>
    <rect x="350" y="66" width="140" height="52" rx="6" class="dg-box" />
    <text x="364" y="98" class="dg-title">Web adapter</text>
    <rect x="510" y="66" width="140" height="52" rx="6" class="dg-box" />
    <text x="524" y="98" class="dg-title">DB adapter</text>
    <rect x="370" y="150" width="260" height="62" rx="6" class="dg-box dg-emphasis" />
    <text x="386" y="176" class="dg-title">Application</text>
    <text x="386" y="198" class="dg-detail">use cases and ports</text>
    <rect x="410" y="246" width="180" height="62" rx="6" class="dg-box dg-emphasis" />
    <text x="426" y="272" class="dg-title">Domain</text>
    <text x="426" y="294" class="dg-detail">rules, no framework</text>
    <path d="M420 118 V148" class="dg-line dg-accent" marker-end="url(#style-arrows-accent)" />
    <path d="M580 118 V148" class="dg-line dg-accent" marker-end="url(#style-arrows-accent)" />
    <path d="M500 212 V244" class="dg-line dg-accent" marker-end="url(#style-arrows-accent)" />
    <rect x="510" y="318" width="140" height="38" rx="6" class="dg-box" />
    <text x="524" y="342" class="dg-detail">database, outside</text>
    <path d="M630 118 C690 160 690 290 652 328" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <text x="346" y="386" class="dg-note">every arrow points to the domain</text>

    <rect x="690" y="20" width="290" height="380" rx="8" class="dg-frame" />
    <text x="706" y="46" class="dg-group">VERTICAL SLICE</text>
    <rect x="706" y="66" width="80" height="250" rx="6" class="dg-box" />
    <text x="716" y="92" class="dg-title">Place</text>
    <text x="716" y="114" class="dg-detail">order</text>
    <rect x="796" y="66" width="80" height="250" rx="6" class="dg-box" />
    <text x="806" y="92" class="dg-title">Cancel</text>
    <text x="806" y="114" class="dg-detail">order</text>
    <rect x="886" y="66" width="80" height="250" rx="6" class="dg-box" />
    <text x="896" y="92" class="dg-title">List</text>
    <text x="896" y="114" class="dg-detail">orders</text>
    <text x="716" y="170" class="dg-note">handler</text>
    <path d="M746 180 V230" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <text x="716" y="250" class="dg-note">data</text>
    <text x="806" y="170" class="dg-note">handler</text>
    <path d="M836 180 V230" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <text x="806" y="250" class="dg-note">data</text>
    <text x="896" y="170" class="dg-note">handler</text>
    <path d="M926 180 V230" class="dg-line" marker-end="url(#style-arrows-arrow)" />
    <text x="896" y="250" class="dg-note">query</text>
    <rect x="706" y="326" width="260" height="34" rx="6" class="dg-box" />
    <text x="720" y="348" class="dg-detail">thin shared base</text>
    <text x="706" y="388" class="dg-note">arrows stay inside a slice</text>
  </svg>
</Diagram>
