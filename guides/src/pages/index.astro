---
import Icon from "../components/Icon.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
import guideData from "../generated/guides.json";

const guides = guideData.guides as Record<string, { draft: boolean }>;
const isDraft = (href: string) => guides[href.replace(/^\/guides\/|\/$/g, "")]?.draft === true;
const draftCount = Object.values(guides).filter((g) => g.draft).length;
const guideCount = Object.keys(guides).length;

const parts = [
  {
    icon: "layers",
    status: "Public preview",
    title: "A knowledge base",
    text: `${guideCount} guides with the practices Pyahu follows for Java services with Spring Boot, from the first build to Kubernetes. Each step answers one question: the failure it prevents, the fix and when to choose differently.`,
    href: "#guides",
    link: "See the guides",
  },
  {
    icon: "terminal",
    status: "Public preview",
    title: "A project generator",
    text: "Generate a hexagonal or DDD layered service with optional PostgreSQL, OIDC and a Next.js frontend, plus observability, Kubernetes manifests and CI. All 16 supported combinations are built and smoke-tested.",
    href: "https://start.pyahu.io/",
    link: "Open the generator",
  },
] as const;

const modules = [
  {
    title: "1. Foundations",
    text: "Set up a service you can change safely for years.",
    guides: [
      { href: "/guides/build-quality/", title: "Build and code quality" },
      { href: "/guides/architecture/", title: "Architecture" },
      { href: "/guides/architecture-styles/", title: "Architecture styles compared" },
      { href: "/guides/testing/", title: "Testing a Spring Boot service" },
    ],
  },
  {
    title: "2. Build the service",
    text: "Expose an API, store data and call other services without surprises.",
    guides: [
      { href: "/guides/rest-apis/", title: "REST APIs, contract first" },
      { href: "/guides/grpc/", title: "gRPC services" },
      { href: "/guides/database/", title: "The database in production" },
      { href: "/guides/jpa-and-jooq/", title: "JPA and jOOQ" },
      { href: "/guides/http-clients/", title: "HTTP clients and resilience" },
      { href: "/guides/virtual-threads/", title: "Virtual threads and concurrency" },
    ],
  },
  {
    title: "3. Events and data",
    text: "Move data between services reliably and keep hot data close.",
    guides: [
      { href: "/guides/kafka/", title: "Kafka with the outbox" },
      { href: "/guides/rabbitmq/", title: "RabbitMQ" },
      { href: "/guides/caching/", title: "Caching with Valkey" },
    ],
  },
  {
    title: "4. Run in production",
    text: "Size it, configure it, see inside it and lock it down.",
    guides: [
      { href: "/guides/jvm-in-containers/", title: "The JVM in containers" },
      { href: "/guides/configuration/", title: "Configuration and secrets" },
      { href: "/guides/observability/", title: "Observability" },
      { href: "/guides/security/", title: "Security hardening" },
    ],
  },
  {
    title: "5. Ship",
    text: "Turn a commit into a running pod you can trust.",
    guides: [
      { href: "/guides/container-image/", title: "The container image" },
      { href: "/guides/ci-pipelines/", title: "CI pipelines" },
      { href: "/guides/kubernetes-deployment/", title: "Deploying to Kubernetes" },
      { href: "/guides/kubernetes-manifests/", title: "Kubernetes manifests" },
    ],
  },
  {
    title: "6. Grow",
    text: "Work fast locally, add services and put a frontend next to them.",
    guides: [
      { href: "/guides/local-development/", title: "Local development" },
      { href: "/guides/monorepo/", title: "Monorepos with several services" },
      { href: "/guides/nextjs/", title: "Next.js next to the service" },
    ],
  },
];

const anatomy = [
  { title: "Questions first", text: "The top of each guide lists the questions it answers. Click one and you land on the answer." },
  { title: "One step per question", text: "Each step starts with the answer in short, then what goes wrong, what to do and when the advice is not for you." },
  { title: "Put it all together", text: "Files to copy, each with a short explanation and one way to check it works. They come from a service that CI builds and tests." },
  { title: "Checklist", text: "Short items with stable IDs, to review a service against the guide." },
];

const proof = [
  { title: "Exact versions", text: "Every guide is written for one list of exact versions, the baseline. The reference page lists it with the official documentation for each version." },
  { title: "A real service behind the code", text: "The code in the guides comes from a service that CI builds, starts and tests. The 16 project combinations of the generator are built and started too." },
  { title: "Tests where they matter", text: "Claims about roles, migrations, startup and failure handling name the test CI runs on every change. Each guide says which steps are tested here and which rest on the official documentation." },
  { title: "Kept current", text: "Renovate watches the dependencies. A version update lands only when the tests behind the claims still pass." },
  { title: "Honest about the rest", text: `${draftCount} guides have no tested step yet and are marked Draft. A green build proves only the checks that ran.` },
];

const roadmap = [
  { when: "Now", text: `${guideCount} guides in six parts and a generator preview at start.pyahu.io, on baseline ${guideData.active}.` },
  { when: "Next", text: "Two or three teams take the recommended path with a real service. Their reports decide what we test next and what we cut." },
  { when: "Later", text: "New generator options, such as Kafka, gRPC or JPA, when teams ask for them. Each one arrives with its guide and its tests." },
];
---

<LandingLayout title="Pyahu Initializer" description="Guides for running Java services with Spring Boot in production and a generator for tested starter projects.">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="signal"></span>Java · Spring Boot · Kubernetes</p>
        <h1>Production Java, explained. <span>Then generated.</span></h1>
        <p class="hero-copy">Pyahu Initializer is a set of guides for running Spring Boot services in production and a generator that starts a project already following them.</p>
        <div class="hero-actions">
          <a class="button primary" href="/start-here/">Start here <Icon name="arrow" size={18} /></a>
          <a class="button quiet" href="https://start.pyahu.io/">Generate a project</a>
        </div>
      </div>
      <div class="setup-panel" aria-label="The two parts of the Initializer">
        <div class="panel-bar"><span></span><span></span><span></span><code>initializer</code></div>
        <div class="setup-body">
          <p class="setup-label">1. Learn why each decision is made</p>
          <pre><code>{modules.map((m, i) => (
  <>{i > 0 && "\n"}<span class="prompt">{i + 1}</span> {m.title.replace(/^\d+\. /, "").padEnd(20)}<span class="comment">{m.guides.length} guides</span></>
))}</code></pre>
          <p class="setup-label panel-gap">2. Start a project that already follows them</p>
          <pre><code><span class="prompt">$</span> curl https://start.pyahu.io/starter.zip -d name=orders -o orders.zip
<span class="comment">  or open <a href="https://start.pyahu.io/">start.pyahu.io</a></span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="what" aria-labelledby="what-title">
    <div class="section-heading">
      <p class="eyebrow">What it is</p>
      <h2 id="what-title">Two parts, one standard.</h2>
      <p class="section-lead">The guides say how a production service should be built and why. The generator is the shortcut: it skips the wiring, not the understanding.</p>
    </div>
    <div class="part-grid">
      {parts.map((p) => (
        <article class="benefit-card part-card">
          <div class="part-head"><Icon name={p.icon} size={25} /><span class="pill">{p.status}</span></div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <a class="text-link" href={p.href}>{p.link} <Icon name="arrow" size={15} /></a>
        </article>
      ))}
    </div>
    <a class="text-link" href="/why/">Why it exists <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section" id="guides" aria-labelledby="guides-title">
    <div class="section-heading">
      <p class="eyebrow">The guides</p>
      <h2 id="guides-title">Six parts, one service.</h2>
      <p class="section-lead">Follow them in order to build a service from the first commit to production or jump straight to the question you have today. A guide marked Draft has no tested step yet.</p>
    </div>
    <div class="profile-grid module-grid">
      {modules.map((m) => (
        <article class="profile-card module-card">
          <h3>{m.title}</h3>
          <p>{m.text}</p>
          <ul>
            {m.guides.map((g) => (
              <li><a href={g.href}>{g.title}</a>{isDraft(g.href) && <span class="pill draft-pill">Draft</span>}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <a class="text-link" href="/guides/">All guides <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section proof-section" id="inside" aria-labelledby="inside-title">
    <div class="section-heading">
      <p class="eyebrow">Inside a guide</p>
      <h2 id="inside-title">Built to be read fast.</h2>
      <p class="section-lead">Read the questions, jump to the answer, copy the file. The detail is there when you need it.</p>
    </div>
    <div class="proof-grid">
      {anatomy.map((a) => (
        <article><strong>{a.title}</strong><p>{a.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section proof-section" id="proof" aria-labelledby="proof-title">
    <div class="section-heading">
      <p class="eyebrow">How the guides are proven</p>
      <h2 id="proof-title">Advice you can check.</h2>
      <p class="section-lead">Most production advice is copied from somewhere. Here each guide says which steps a test proves and which rest on the official documentation.</p>
    </div>
    <div class="proof-grid">
      {proof.map((p) => (
        <article><strong>{p.title}</strong><p>{p.text}</p></article>
      ))}
    </div>
    <a class="text-link" href="/maintenance/">How we keep it current <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section" id="community" aria-labelledby="community-title">
    <div class="section-heading">
      <p class="eyebrow">Pyahu Community</p>
      <h2 id="community-title">From the laptop to the cluster.</h2>
      <p class="section-lead">These guides cover the service. The Pyahu Community guides index lists the problems the other open source projects solve too, from the developer's machine to the cluster, each linked to its answer.</p>
    </div>
    <a class="text-link" href="https://pyahu.io/guides">Pyahu Community guides <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section proof-section" id="roadmap" aria-labelledby="roadmap-title">
    <div class="section-heading">
      <p class="eyebrow">Roadmap</p>
      <h2 id="roadmap-title">Guides first, then the generator.</h2>
      <p class="section-lead">The generator keeps its current options while teams try the recommended path. No dates are promised.</p>
    </div>
    <div class="proof-grid">
      {roadmap.map((r) => (
        <article><strong>{r.when}</strong><p>{r.text}</p></article>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <p class="eyebrow center">Start reading</p>
    <h2>Take one service to production.</h2>
    <div class="hero-actions center">
      <a class="button primary" href="/start-here/">Start here <Icon name="arrow" size={18} /></a>
      <a class="button quiet" href="/guides/">All guides</a>
    </div>
  </section>
</LandingLayout>
