---
import Icon from "../components/Icon.astro";
import LandingLayout from "../layouts/LandingLayout.astro";

const parts = [
  {
    icon: "layers",
    status: "Available",
    title: "A knowledge base",
    text: "A course of 24 guides for building Java services with Spring Boot and a Next.js frontend next to them. Each step answers one question: the failure it prevents, the fix and when to choose differently.",
    href: "#guides",
    link: "See the course",
  },
  {
    icon: "terminal",
    status: "In development",
    title: "A project generator",
    text: "pyahu new will create a service that already follows the guides: sized for containers, observability wired, Kubernetes manifests and CI included, in the architecture you choose.",
    href: "#roadmap",
    link: "See the roadmap",
  },
] as const;

const modules = [
  {
    title: "1. Foundations",
    text: "Set up a service you can change safely for years.",
    guides: [
      { href: "/guides/build-quality/", title: "Build and code quality" },
      { href: "/guides/architecture/", title: "Architecture" },
      { href: "/guides/architecture-styles/", title: "Architecture styles compared" },
      { href: "/guides/testing/", title: "Testing a Spring Boot service" },
    ],
  },
  {
    title: "2. Build the service",
    text: "Expose an API, store data and call other services without surprises.",
    guides: [
      { href: "/guides/rest-apis/", title: "REST APIs, contract first" },
      { href: "/guides/grpc/", title: "gRPC services" },
      { href: "/guides/database/", title: "The database in production" },
      { href: "/guides/jpa-and-jooq/", title: "JPA and jOOQ" },
      { href: "/guides/http-clients/", title: "HTTP clients and resilience" },
      { href: "/guides/virtual-threads/", title: "Virtual threads and concurrency" },
    ],
  },
  {
    title: "3. Events and data",
    text: "Move data between services reliably and keep hot data close.",
    guides: [
      { href: "/guides/kafka/", title: "Kafka with the outbox" },
      { href: "/guides/rabbitmq/", title: "RabbitMQ" },
      { href: "/guides/caching/", title: "Caching with Valkey" },
    ],
  },
  {
    title: "4. Run in production",
    text: "Size it, configure it, see inside it and lock it down.",
    guides: [
      { href: "/guides/jvm-in-containers/", title: "The JVM in containers" },
      { href: "/guides/configuration/", title: "Configuration and secrets" },
      { href: "/guides/observability/", title: "Observability" },
      { href: "/guides/security/", title: "Security hardening" },
    ],
  },
  {
    title: "5. Ship",
    text: "Turn a commit into a running pod you can trust.",
    guides: [
      { href: "/guides/container-image/", title: "The container image" },
      { href: "/guides/ci-pipelines/", title: "CI pipelines" },
      { href: "/guides/kubernetes-deployment/", title: "Deploying to Kubernetes" },
      { href: "/guides/kubernetes-manifests/", title: "Kubernetes manifests" },
    ],
  },
  {
    title: "6. Grow",
    text: "Work fast locally, add services and put a frontend next to them.",
    guides: [
      { href: "/guides/local-development/", title: "Local development" },
      { href: "/guides/monorepo/", title: "Monorepos with several services" },
      { href: "/guides/nextjs/", title: "Next.js next to the service" },
    ],
  },
];

const anatomy = [
  { title: "Questions first", text: "The top of each guide lists the questions it answers. Click one and you land on the answer." },
  { title: "One step per question", text: "Each step starts with the answer in short, then what goes wrong, what to do and when the advice is not for you." },
  { title: "Put it all together", text: "Files to copy with a short explanation, cut from a real service that is built and run on every change." },
  { title: "Checklist", text: "Short items with stable IDs, to review a service against the guide." },
];

const proof = [
  { title: "Exact versions", text: "Each guide is written for one baseline: a frozen list of versions, such as Java 25 and Spring Boot 4.1.1. The reference page lists them with the official docs for each." },
  { title: "A real service behind the code", text: "Code in a guide comes from a small service in the repository. CI builds it and runs it on every change, so an upgrade that breaks the advice turns CI red first." },
  { title: "A test behind each claim", text: "Each claim is tied to a test, its command and its result, such as a 768 MiB heap in a 1 GiB pod. The records live on GitHub next to the CI runs that produced them." },
  { title: "Gaps said out loud", text: "Some claims need a cluster or a load test that has not run yet. Their records say \"not exercised\" and why, so nothing untested passes as proven." },
];

const roadmap = [
  { when: "Now", text: "The course: 24 guides in six modules, from the first build to Kubernetes, messaging and a Next.js frontend." },
  { when: "Next", text: "Generator v0.1: one service, hexagonal or DDD layered, REST with PostgreSQL, OIDC, OpenTelemetry, Kustomize and CI." },
  { when: "Later", text: "The generator grows with the course: monorepos, JPA and jOOQ, gRPC, Kafka, RabbitMQ, Valkey and Next.js, each once its tested service exists." },
];
---

<LandingLayout title="Pyahu Initializer" description="A knowledge base for production Java with Spring Boot and Next.js and a generator for production-ready projects.">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="signal"></span>Java · Spring Boot · Next.js · Kubernetes</p>
        <h1>Production Java, explained. <span>Then generated.</span></h1>
        <p class="hero-copy">Pyahu Initializer is a modern knowledge base for building applications with Spring Boot and Next.js and a generator that starts new projects at production quality, following the same guides.</p>
        <div class="hero-actions">
          <a class="button primary" href="/course/">Start the course <Icon name="arrow" size={18} /></a>
          <a class="button quiet" href="#what">What it is</a>
        </div>
      </div>
      <div class="setup-panel" aria-label="The two parts of the Initializer">
        <div class="panel-bar"><span></span><span></span><span></span><code>initializer</code></div>
        <div class="setup-body">
          <p class="setup-label">1. Learn why each decision is made</p>
          <pre><code><span class="prompt">1</span> Foundations         <span class="comment">4 guides</span>
<span class="prompt">2</span> Build the service   <span class="comment">6 guides</span>
<span class="prompt">3</span> Events and data     <span class="comment">3 guides</span>
<span class="prompt">4</span> Run in production   <span class="comment">4 guides</span>
<span class="prompt">5</span> Ship                <span class="comment">4 guides</span>
<span class="prompt">6</span> Grow                <span class="comment">3 guides</span></code></pre>
          <p class="setup-label panel-gap">2. Start a project that already follows them</p>
          <pre><code><span class="prompt">$</span> pyahu new orders --auth
<span class="comment">  in development</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="what" aria-labelledby="what-title">
    <div class="section-heading">
      <p class="eyebrow">What it is</p>
      <h2 id="what-title">Two parts, one standard.</h2>
      <p class="section-lead">The guides say how a production service should be built and why. The generator is the shortcut: it skips the wiring, not the understanding.</p>
    </div>
    <div class="part-grid">
      {parts.map((p) => (
        <article class="benefit-card part-card">
          <div class="part-head"><Icon name={p.icon} size={25} /><span class="pill">{p.status}</span></div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <a class="text-link" href={p.href}>{p.link} <Icon name="arrow" size={15} /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="guides" aria-labelledby="guides-title">
    <div class="section-heading">
      <p class="eyebrow">The course</p>
      <h2 id="guides-title">Six modules, one service.</h2>
      <p class="section-lead">Follow them in order to build a service from the first commit to production or jump straight to the question you have today.</p>
    </div>
    <div class="profile-grid module-grid">
      {modules.map((m) => (
        <article class="profile-card module-card">
          <h3>{m.title}</h3>
          <p>{m.text}</p>
          <ul>
            {m.guides.map((g) => (
              <li><a href={g.href}>{g.title}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <a class="text-link" href="/course/">How the course works <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section proof-section" id="inside" aria-labelledby="inside-title">
    <div class="section-heading">
      <p class="eyebrow">Inside a guide</p>
      <h2 id="inside-title">Built to be read fast.</h2>
      <p class="section-lead">Read the questions, jump to the answer, copy the file. The detail is there when you need it.</p>
    </div>
    <div class="proof-grid">
      {anatomy.map((a) => (
        <article><strong>{a.title}</strong><p>{a.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section proof-section" id="proof" aria-labelledby="proof-title">
    <div class="section-heading">
      <p class="eyebrow">How the guides are proven</p>
      <h2 id="proof-title">Advice you can check.</h2>
      <p class="section-lead">Most production advice is copied from somewhere. Here every claim shows where it was checked or says that it was not.</p>
    </div>
    <div class="proof-grid">
      {proof.map((p) => (
        <article><strong>{p.title}</strong><p>{p.text}</p></article>
      ))}
    </div>
    <a class="text-link" href="https://github.com/pyahu/initializer/tree/main/data/evidence">See the evidence on GitHub <Icon name="arrow" size={15} /></a>
  </section>

  <section class="section proof-section" id="roadmap" aria-labelledby="roadmap-title">
    <div class="section-heading">
      <p class="eyebrow">Roadmap</p>
      <h2 id="roadmap-title">Guides first, then the generator.</h2>
      <p class="section-lead">Every option gets its guide and a tested service before the generator offers it. No dates are promised.</p>
    </div>
    <div class="proof-grid">
      {roadmap.map((r) => (
        <article><strong>{r.when}</strong><p>{r.text}</p></article>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <p class="eyebrow center">Start reading</p>
    <h2>Start with a build you can trust.</h2>
    <div class="hero-actions center">
      <a class="button primary" href="/course/">The course <Icon name="arrow" size={18} /></a>
      <a class="button quiet" href="/guides/build-quality/">Module 1: Build and code quality</a>
    </div>
  </section>
</LandingLayout>
