---
// Every fixture file a recipe references, published complete next to the guides,
// so the excerpt, the full file and the llms exports stay on one site.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import data from "../../generated/fixture-files.json";

export function getStaticPaths() {
  return data.files.map((f) => ({ params: { path: f.path.replace(/^fixtures\//, "") }, props: f }));
}
const f = Astro.props as (typeof data.files)[number];
const content = readFileSync(resolve(process.cwd(), "..", f.path), "utf8");
---
<StarlightPage frontmatter={{ title: f.path, description: `A file from the ${f.fixture} example service.`, tableOfContents: false }}>
  <p><a href={`https://github.com/pyahu/initializer/blob/main/${f.path}`}>View on GitHub</a></p>
  <pre class="fixture-file"><code>{content}</code></pre>
</StarlightPage>
