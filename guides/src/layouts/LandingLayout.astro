---
import "../styles/landing.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL("/", "https://initializer.pyahu.io");
const navigation = [
  { href: "#what", label: "What it is" },
  { href: "#guides", label: "Course" },
  { href: "#proof", label: "How it is proven" },
  { href: "#roadmap", label: "Roadmap" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b16" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/assets/mark.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container" id="top">
      <a class="brand" href="/" aria-label="Pyahu Initializer home">
        <img src="/assets/mark.svg" alt="" width="34" height="34" />
        <span>pyahu<span class="brand-divider">/</span><span class="brand-product">initializer</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="nav-cta" href="/course/">Start the course <Icon name="arrow" size={16} /></a>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/"><img src="/assets/mark.svg" alt="" width="28" height="28" />pyahu<span class="brand-product">initializer</span></a>
          <p>A knowledge base for production Java and a generator that follows it.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/course/">Course</a>
          <a href="/reference/docs/">Reference docs</a>
          <a href="/contributing/style/">Style guide</a>
          <a href="https://github.com/pyahu/initializer">GitHub</a>
          <a href="https://pyahu.io">Pyahu <Icon name="arrow" size={15} /></a>
        </nav>
      </div>
      <p class="footer-legal">By Terson Rigaud · Code MIT, text CC BY 4.0 · Pyahu Community</p>
    </footer>
  </body>
</html>
